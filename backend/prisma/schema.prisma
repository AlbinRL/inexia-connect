// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// 1. Configuration de la source de données

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// Enum pour les rôles des utilisateurs
enum Role {
  USER
  COLLABORATEUR
  ADMIN
  DIRECTEUR
}

// 3. Modèles de données (Tes Tables)

model Utilisateur {
  id           Int           @id @default(autoincrement())
  nom          String
  prenom       String
  email        String        @unique
  motDePasse   String
  role         Role          @default(USER)
  siteId       Int?
  site         Site?         @relation(fields: [siteId], references: [id])
  reservations Reservation[]
}

model Site {
  id           Int           @id @default(autoincrement())
  nom          String
  ville        String
  salles       Salle[]
  utilisateurs Utilisateur[]
  materiels    Materiel[]
}

model Salle {
  id           Int           @id @default(autoincrement())
  nom          String
  capacite     Int
  siteId       Int
  site         Site          @relation(fields: [siteId], references: [id])
  equipements  Equipement[]
  reservations Reservation[]
}

model Equipement {
  id      Int     @id @default(autoincrement())
  nom     String
  actif   Boolean @default(true)
  salleId Int
  salle   Salle   @relation(fields: [salleId], references: [id])
}

model Materiel {
  id             Int                   @id @default(autoincrement())
  nom            String
  quantiteTotale Int
  siteId         Int
  site           Site                  @relation(fields: [siteId], references: [id])
  reservations   ReservationMateriel[]
}

model Reservation {
  id            Int                   @id @default(autoincrement())
  date          DateTime
  utilisateurId Int
  utilisateur   Utilisateur           @relation(fields: [utilisateurId], references: [id])
  salleId       Int
  salle         Salle                 @relation(fields: [salleId], references: [id])
  materiels     ReservationMateriel[]
}

model ReservationMateriel {
  reservationId Int
  materielId    Int
  quantite      Int

  reservation   Reservation @relation(fields: [reservationId], references: [id])
  materiel      Materiel    @relation(fields: [materielId], references: [id])

  @@id([reservationId, materielId])
}

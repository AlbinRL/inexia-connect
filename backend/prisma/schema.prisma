// 1. Configuration
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// 2. Enums et Modèles de base
enum Role {
  USER
  COLLABORATEUR
  ADMIN
  DIRECTEUR
}

model Utilisateur {
  id           Int           @id @default(autoincrement())
  nom          String
  prenom       String
  email        String        @unique
  motDePasse   String
  role         Role          @default(USER)
  siteId       Int?
  site         Site?         @relation(fields: [siteId], references: [id])
  reservations Reservation[]
}

model Site {
  id            Int           @id @default(autoincrement())
  nom           String
  ville         String
  salles        Salle[]
  utilisateurs  Utilisateur[]
}

// 3. Modèles pour la gestion des salles et équipements

// Le référentiel : liste unique de tous les matériels possibles
model Materiel {
  id          Int          @id @default(autoincrement())
  nom         String       @unique // "Vidéoprojecteur", "Ordinateur", etc.
  equipements Equipement[] // Lien vers les salles possédant ce matériel
}

model Salle {
  id           Int           @id @default(autoincrement())
  nom          String
  capacite     Int
  siteId       Int
  site         Site          @relation(fields: [siteId], references: [id])
  equipements  Equipement[]  // Liste des équipements présents dans cette salle
  reservations Reservation[]
}

// La table de jointure : précise quelle salle a quel matériel et en quelle quantité
model Equipement {
  id         Int      @id @default(autoincrement())
  salleId    Int
  materielId Int
  quantite   Int      @default(1)
  
  salle      Salle    @relation(fields: [salleId], references: [id])
  materiel   Materiel @relation(fields: [materielId], references: [id])

  @@unique([salleId, materielId]) // Empêche d'avoir deux fois le même matériel dans la même salle
}

// 4. Modèle de réservation simplifié
model Reservation {
  id            Int         @id @default(autoincrement())
  date          DateTime
  utilisateurId Int
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  salleId       Int
  salle         Salle       @relation(fields: [salleId], references: [id])
}
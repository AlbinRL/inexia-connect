// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// 1. Configuration de la source de données

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// 3. Modèles de données (Tes Tables)

model Utilisateur {
  id           Int           @id @default(autoincrement())
  nom          String
  prenom       String
  email        String        @unique
  motDePasse   String
  role         String        // 'ADMIN', 'COLLABORATEUR', 'DIRECTEUR'
  reservations Reservation[]
}

model Site {
  id     Int     @id @default(autoincrement())
  nom    String
  ville  String
  salles Salle[]
}

model Salle {
  id           Int           @id @default(autoincrement())
  nom          String
  capacite     Int
  siteId       Int
  site         Site          @relation(fields: [siteId], references: [id])
  equipements  Equipement[]
  reservations Reservation[]
}

model Equipement {
  id      Int     @id @default(autoincrement())
  nom     String
  actif   Boolean @default(true)
  salleId Int
  salle   Salle   @relation(fields: [salleId], references: [id])
}

model Reservation {
  id            Int         @id @default(autoincrement())
  date          DateTime
  utilisateurId Int
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  salleId       Int
  salle         Salle       @relation(fields: [salleId], references: [id])
}
